# Optional. Defaults to the current working directory.
# FIREFLY_MCP_DATA_DIR=C:\Users\you\.adobe-firefly-mcp

# Defaults to false because first-run Adobe sign-in must be manual.
FIREFLY_HEADLESS=false

# Use your real Chrome profile with existing login (for debugging/investigation)
# Set to true to launch Chrome using your installed Chrome browser with your existing profile
# This bypasses Playwright's bundled Chromium and uses your real Chrome instead
# FIREFLY_USE_PERSISTENT_PROFILE=false

# Path to Chrome user data directory (required if FIREFLY_USE_PERSISTENT_PROFILE=true)
# On Windows: C:\Users\<username>\AppData\Local\Google\Chrome\User Data
# On Mac: ~/Library/Application Support/Google/Chrome
# On Linux: ~/.config/google-chrome
# FIREFLY_USER_DATA_DIR=

# Optional URL overrides. Adobe may change routes without notice.
# FIREFLY_TEXT_TO_IMAGE_URL=https://firefly.adobe.com/
# FIREFLY_VARIATIONS_URL=https://firefly.adobe.com/
# FIREFLY_EXPAND_URL=https://firefly.adobe.com/
# FIREFLY_REMOVE_BACKGROUND_URL=https://firefly.adobe.com/

# Optional selector overrides when Firefly UI changes.
# FIREFLY_SELECTOR_PROMPT_INPUT=textarea
# FIREFLY_SELECTOR_GENERATE_BUTTON=button:has-text("Generate")
# FIREFLY_SELECTOR_DOWNLOAD_BUTTON=button:has-text("Download")
# FIREFLY_SELECTOR_UPLOAD_BUTTON=button:has-text("Upload")

# debug, info, warn, error, or silent
FIREFLY_LOG_LEVEL=info
